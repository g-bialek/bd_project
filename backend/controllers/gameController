const db = require("../db/db")

const getAllGames = async(req,res) => {
    try {
        const [rows] = await db.query(`
            SELECT m.id_meczu, dh.nazwa_druzyny AS 'gospodarze', da.nazwa_druzyny AS 'goscie', m.data_meczu,
            m.gospodarze_gole, m.goscie_gole
            FROM mecze m

            JOIN druzyny dh ON m.gospodarze_id = dh.id_druzyny
            JOIN druzyny da ON m.goscie_id = da.id_druzyny

            ORDER BY m.data_meczu DESC
        `)

        res.json(rows)
    }

    catch(error){
        console.error(error);

        res.status(500).json({
            message: "Database error"
        });
    }
};

const getGameByID = async(req,res) => {
    try {

        const {id} = req.params;

        const [gameRows] = await db.query(`
            SELECT m.id_meczu, m.gospodarze_id, m.goscie_id, m.stadion_id,dh.nazwa_druzyny AS 'gospodarze', da.nazwa_druzyny AS 'goscie', s.nazwa_stadionu, m.data_meczu, m.runda_rozgrywek,
            m.gospodarze_gole, m.goscie_gole
            FROM mecze m

            JOIN druzyny dh ON m.gospodarze_id = dh.id_druzyny
            JOIN druzyny da ON m.goscie_id = da.id_druzyny

            JOIN stadiony s ON m.stadion_id = s.id_stadionu

            WHERE m.id_meczu = ?
        `, [id]);

        if(gameRows.length === 0){
            return res.status(404).json({
                message: "Nie znaleziono meczu!"
            });
        }

        const [refereeRow] = await db.query(`
            SELECT 
                  r.id_sedziego,  
                  rm.rola,
                  r.imie_sedziego,
                  r.nazwisko_sedziego
            FROM sedziowie_meczow rm
            JOIN sedziowie r ON rm.sedzia_id = r.id_sedziego

            WHERE mecz_id = ?
        `, [id])

        const sedziaGlowny = refereeRow.find(
            (r) => r.rola === "Glowny"
        );

        const sedziaVAR = refereeRow.find(
            (r) => r.rola === "VAR"
        );
        
        const game = {
            id: gameRows[0].id_meczu,
            gospodarze: gameRows[0].gospodarze,
            gospodarze_gole: gameRows[0].gospodarze_gole,
            goscie: gameRows[0].goscie,
            goscie_gole: gameRows[0].goscie_gole,
            data_meczu: gameRows[0].data_meczu.toISOString().split("T")[0],
            runda_rozgrywek: gameRows[0].runda_rozgrywek,
            stadion: gameRows[0].nazwa_stadionu,
            gospodarze_id: gameRows[0].gospodarze_id,
            goscie_id: gameRows[0].goscie_id,
            stadion_id: gameRows[0].stadion_id,
            sedzia_glowny_id: sedziaGlowny?.id_sedziego || "",
            sedzia_var_id: sedziaVAR?.id_sedziego || "",
            sedziowie: refereeRow
        }
        res.json(game)
    }

    catch(error){
        console.error(error);

        res.status(500).json({
            message: "Database error"
        });
    }
};

const createGame = async (req,res) => {
    try {
        const {
            gospodarze_id,
            goscie_id,
            stadion_id,
            data_meczu,
            runda_rozgrywek,
            gospodarze_gole,
            goscie_gole,

            sedzia_glowny_id,
            sedzia_var_id
        } = req.body

        const [result] = await db.query(`
            INSERT INTO mecze (
                gospodarze_id,
                goscie_id,
                stadion_id,
                data_meczu,
                runda_rozgrywek,
                gospodarze_gole,
                goscie_gole
            )
            VALUES (?, ?, ?, ?, ?, ?, ?)
        `, [
            gospodarze_id,
            goscie_id,
            stadion_id,
            data_meczu,
            runda_rozgrywek,
            gospodarze_gole,
            goscie_gole
        ]);

        const mecz_id = result.insertId;

        await db.query(`
            INSERT INTO sedziowie_meczow (
                mecz_id,
                sedzia_id,
                rola
            )
            VALUES (?, ?, ?)
        `, [
            mecz_id,
            sedzia_glowny_id,
            "Glowny"
        ]);

        await db.query(`
            INSERT INTO sedziowie_meczow (
                mecz_id,
                sedzia_id,
                rola
            )
            VALUES (?, ?, ?)
        `, [
            mecz_id,
            sedzia_var_id,
            "VAR"
        ]);

        res.status(201).json({
            message: "Mecz utworzony"
        });
    }

    catch(error){
        console.error(error);

        res.status(500).json({
            message: "Database error"
        });
    }
}

const updateGame = async(req,res) => {
    try {
        const {
            gospodarze_id,
            goscie_id,
            stadion_id,
            data_meczu,
            runda_rozgrywek,
            gospodarze_gole,
            goscie_gole,
            sedzia_glowny_id,
            sedzia_var_id
        } = req.body;

        const {id} = req.params

        await db.query(`
            UPDATE mecze
            SET
                gospodarze_id = ?,
                goscie_id = ?,
                stadion_id = ?,
                data_meczu = ?,
                runda_rozgrywek = ?,
                gospodarze_gole = ?,
                goscie_gole = ?
            WHERE id_meczu = ?
        `, [
            gospodarze_id,
            goscie_id,
            stadion_id,
            data_meczu,
            runda_rozgrywek,
            gospodarze_gole,
            goscie_gole,
            id
        ]);

         await db.query(`
            DELETE FROM sedziowie_meczow
            WHERE mecz_id = ?
        `, [id]);

        await db.query(`
            INSERT INTO sedziowie_meczow (
                mecz_id,
                sedzia_id,
                rola
            )
            VALUES (?, ?, ?)
        `, [
            id,
            sedzia_glowny_id,
            "Glowny"
        ]);

        await db.query(`
            INSERT INTO sedziowie_meczow (
                mecz_id,
                sedzia_id,
                rola
            )
            VALUES (?, ?, ?)
        `, [
            id,
            sedzia_var_id,
            "VAR"
        ]);

        res.json({
            message: "Match updated"
        });
    }

    catch(error){
        console.error(error);

        res.status(500).json({
            message: "Database error"
        });
    }
}

const deleteGame = async (req,res) => {
    try{
        const {id} = req.params;

        await db.query(`
            DELETE FROM sedziowie_meczow WHERE mecz_id = ?  
        `, [id]);

        await db.query(`
            DELETE FROM mecze
            WHERE id_meczu = ?
        `, [id]);

        res.json({
            message: "Mecz usuniety"
        });
    }

    catch(error){
        console.error(error);
        res.status(500).json({
            message: "Database error"
        });
    }
}


module.exports = {
    getAllGames,
    getGameByID,
